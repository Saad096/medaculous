# Docker Compose variable substitution for docker-compose.yml ONLY — this is
# NOT read by the backend app itself (that's backend/.env, a separate file
# with its own .env.example; see README.md §5). Copy this file to .env and
# only change values that differ from the defaults below.
#
# Every value here already has a matching default baked into
# docker-compose.yml, so on a machine that matches the defaults (the local
# dev setup from README §6a: Postgres user "saad", password "123", database
# "medaculous", backend on port 8000) you don't even need to create a real
# .env from this — it's only required when a machine's setup differs, e.g. a
# shared VM with a different Postgres user or a port already taken by
# another app (see README §8).

# Must match whatever Postgres user/password/database you created on THIS
# machine in README §6a.
DB_USER=saad
DB_PASSWORD=123
DB_NAME=medaculous

# Host port the backend is published on. Only override this if 8000 is
# already used by something else on this machine.
BACKEND_PORT=8000
