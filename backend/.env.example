# ENV controls dev/prod behavior everywhere (OTP delivery, error verbosity, CORS, etc.)
ENV=dev

# Public base URL of THIS backend, per environment (localhost in dev, the real
# VM/domain in prod) — every place that builds a link reads this instead of a
# hardcoded host.
APP_BASE_URL=http://localhost:8000

# Docker Compose: use the "db" service hostname. Local Postgres system service: use localhost.
DATABASE_URL=postgresql+asyncpg://medaculous:medaculous@db:5432/medaculous

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# true: OTP codes print to server logs instead of sending real email (safe default for a
# fresh clone with no AZURE_COMMUNICATION_* creds yet). Set to false once those are
# configured to always send real OTP emails, in every environment including dev.
OTP_DEV_MODE=true
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS_PER_CODE=5
OTP_MAX_REQUESTS_PER_EMAIL_PER_HOUR=5
OTP_MAX_REQUESTS_PER_IP_PER_HOUR=20

# Azure Communication Services Email — the OTP delivery provider (see services/email.py).
# Connection string + verified sender from the ACS resource's "Email" blade.
AZURE_COMMUNICATION_CONNECTION_STRING=
AZURE_COMMUNICATION_SENDER=

# Web client ID (used to verify Google ID tokens server-side). Provide Android/iOS/Web
# client IDs separately if the mobile clients need their own OAuth client registrations.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID_ANDROID=
GOOGLE_CLIENT_ID_IOS=

APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=

# Confirm current model IDs against https://docs.claude.com at implementation time.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_HAIKU=claude-haiku-4-5
ANTHROPIC_MODEL_SONNET=claude-sonnet-5
ANTHROPIC_MODEL_OPUS=claude-opus-5

# Kept server-side only (never sent to any client) — see DISCOVERY_REPORT.md for why
# (the legacy app leaked this key by handing it to the client) and OPEN_QUESTIONS.md
# for the Gemini-vs-Anthropic provider decision.
GEMINI_API_KEY=

AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_KEY=
AZURE_SEARCH_INDEX=medaculous-knowledge

# Knowledge Hub PDF storage — local disk path (relative to backend/) for now.
PDF_STORAGE_DIR=data/pdfs
PDF_MAX_UPLOAD_MB=100

# Profile photo storage — local disk path (relative to backend/) for now.
AVATAR_STORAGE_DIR=data/avatars
AVATAR_MAX_UPLOAD_MB=5

# Payment processor — not wired up yet. Leave blank: CheckoutScreen's final "Pay"
# step shows a "coming soon" message instead of charging anything until real keys
# land here and a backend charge/webhook endpoint is built.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Comma-separated list of origins allowed to call the API (mobile app dev builds, web admin, etc.)
CORS_ORIGINS=http://localhost:3000
